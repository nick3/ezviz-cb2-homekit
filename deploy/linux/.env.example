# Optional compatibility overrides. A normal first deployment does not need
# this file: run `docker compose up -d` and configure everything at :8099.
# If these values are present on the first start, the Web wizard imports them.

# Override the published image only when pinning a release or using a mirror.
EZVIZ_HOMEKIT_IMAGE=ghcr.io/nick3/ezviz-cb2-homekit:latest
EZVIZ_PULL_POLICY=always
EZVIZ_SETUP_PORT=8099

# Use the complete serial, not only its final six characters.
EZVIZ_SERIAL=

# Reserve this address in DHCP. The adapter rejects callbacks from other IPs.
EZVIZ_CAMERA_IP=

# LAN address of the Linux VM. Leave blank only on a single-NIC VM; the
# adapter will derive it from the route to EZVIZ_CAMERA_IP.
EZVIZ_LISTEN_IP=

# Allow this TCP port from EZVIZ_CAMERA_IP to the Linux VM.
EZVIZ_CALLBACK_PORT=39000

# software is the portable default. Other accepted values are auto, vaapi,
# cuda, v4l2m2m and rkmpp. GPU passthrough must be configured separately.
EZVIZ_ENCODER=software

# auto uses the camera's live power/work-mode fields. Set mains or battery only
# when the firmware does not report them correctly.
EZVIZ_POWER_MODE=auto

# on_demand keeps only the camera's H.265/AAC source warm and starts HomeKit
# H.264/Opus transcoders when Home opens. continuous keeps both transcoders hot.
EZVIZ_HOMEKIT_TRANSCODE=on_demand

# On battery, retain the established LAN stream after the final viewer leaves.
# PIR/person events use push when available, then fall back to message polling.
# Warm duration accepts 60 to 86400 seconds; 600 seconds is 10 minutes.
EZVIZ_WARM_SECONDS=600
# on enables event preheating; off keeps only the post-view warm window.
EZVIZ_PIR_PREHEAT=on
# Fallback poll cadence after push registration fails (5 to 300 seconds).
EZVIZ_PIR_POLL_SECONDS=15
# Refresh live power state no more often than every 30 seconds.
EZVIZ_POWER_REFRESH_SECONDS=300

EZVIZ_REGION=api.ys7.com
HOMEKIT_NAME=EZVIZ CB2
TZ=Asia/Shanghai

# Defaults fit most Linux distributions. Change only when the Docker named
# volume was intentionally prepared for another numeric UID/GID.
PUID=1000
PGID=1000
