# Required: use the complete serial, not only its final six characters.
EZVIZ_SERIAL=

# Reserve this address in DHCP. The adapter rejects callbacks from other IPs.
EZVIZ_CAMERA_IP=

# LAN address of the Linux VM. Leave blank only on a single-NIC VM; the
# adapter will derive it from the route to EZVIZ_CAMERA_IP.
EZVIZ_LISTEN_IP=

# Allow this TCP port from EZVIZ_CAMERA_IP to the Linux VM.
EZVIZ_CALLBACK_PORT=39000

# software is the portable default. Other accepted values are auto, vaapi,
# cuda, v4l2m2m and rkmpp. GPU passthrough must be configured separately.
EZVIZ_ENCODER=software

EZVIZ_REGION=api.ys7.com
HOMEKIT_NAME=EZVIZ CB2
TZ=Asia/Shanghai

# Defaults fit most Linux distributions. manage.sh replaces these values in
# the process environment with the current account's UID/GID automatically.
PUID=1000
PGID=1000
