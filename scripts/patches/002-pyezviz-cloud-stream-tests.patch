+def test_vtm_stream_client_can_repeat_original_url_with_native_request_shape() -> None:
+    original_url = "ysproto://vtm.example.test:8554/live?dev=CAM123&ssn=token-1"
+    redirect_url = "ysproto://redirect.example.test:6000/live?dev=CAM123"
+    redirect_key = "redirect-key"
+    redirect_body = (
+        b"\x08\xb6\x29"
+        + b"\x2a"
+        + bytes([len(redirect_key)])
+        + redirect_key.encode()
+        + b"\x3a"
+        + bytes([len(redirect_url)])
+        + redirect_url.encode()
+    )
+    success_body = b"\x08\x00\x22\x07ssn-123"
+    sockets = [
+        FakeVtmSocket(
+            [
+                encode_vtm_packet(
+                    redirect_body,
+                    message_code=VtmMessageCode.STREAMINFO_RSP,
+                    sequence=7,
+                )
+            ]
+        ),
+        FakeVtmSocket(
+            [
+                encode_vtm_packet(
+                    success_body,
+                    message_code=VtmMessageCode.STREAMINFO_RSP,
+                    sequence=8,
+                )
+            ]
+        ),
+    ]
+    calls: list[tuple[str, int]] = []
+
+    def socket_factory(
+        address: tuple[str, int],
+        _timeout: float | None,
+    ) -> FakeVtmSocket:
+        calls.append(address)
+        return sockets[len(calls) - 1]
+
+    with VtmStreamClient(
+        original_url,
+        client_version="3.0.5.20180912",
+        include_empty_pds=True,
+        initial_sequence=1,
+        preserve_request_url_on_redirect=True,
+        socket_factory=socket_factory,
+    ) as stream:
+        info = stream.start()
+
+    first_request = _decode_sent_packets(sockets[0].sent)[0]
+    second_request = _decode_sent_packets(sockets[1].sent)[0]
+
+    assert calls == [
+        ("vtm.example.test", 8554),
+        ("redirect.example.test", 6000),
+    ]
+    assert first_request.sequence == 1
+    assert second_request.sequence == 2
+    assert original_url.encode() in second_request.body
+    assert redirect_url.encode() not in second_request.body
+    assert redirect_key.encode() in second_request.body
+    assert second_request.body.count(b"3.0.5.20180912") == 2
+    assert b"\x2a\x00" in second_request.body
+    assert info.result == 0
+
+
