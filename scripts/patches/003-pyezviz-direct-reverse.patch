+        parsed = self._send_device_transfer(
+            serial,
+            device_session=selected_session,
+            inner_payload=_build_direct_reverse_setup_xml(
+                operation_code=selected_session.operation_code,
+                listener_ip=listener_ip,
+                listener_port=listener_port,
+            ),
+            inner_command=CAS_COMMAND_DIRECT_REVERSE_SETUP,
+            inner_encrypted=True,
+            client_type=client_type,
+            inner_sequence=inner_sequence,
+            outer_sequence=outer_sequence,
+        )
+        if parsed.outer_result != 0 or parsed.inner_result != 0:
+            raise PyEzvizError(
+                "EZVIZ direct-reverse setup was rejected "
+                f"(outer={parsed.outer_result}, inner={parsed.inner_result})"
+            )
+        return parsed
+
+    def query_device_glint_light(
+        self,
+        serial: str,
+        *,
+        device_session: CasDeviceSession | None = None,
+    ) -> CasTransferResponse:
+        """Send a read-only nested transfer to validate CAS framing."""
+        selected_session = device_session or CasDeviceSession.from_response(
+            self.cas_get_encryption(serial)
+        )
+        return self._send_device_transfer(
+            serial,
+            device_session=selected_session,
+            inner_payload=_build_query_glint_light_xml(
+                operation_code=selected_session.operation_code
+            ),
+            inner_command=CAS_COMMAND_QUERY_GLINT_LIGHT,
+            inner_encrypted=False,
+        )
+
+    def invite_direct_reverse_stream(
+        self,
+        *,
+        session_flag: str,
+        serial: str,
+        listener_ip: str,
+        listener_port: int,
+        device_session: CasDeviceSession,
+        channel: int = 1,
+        stream_type: int = 2,
+        transport_protocol: int = 1,
+        encrypt_stream: bool = True,
+    ) -> CasInviteStreamResponse:
+        """Invite an owned camera to send preview media to a local listener."""
+        client_session = self._token.get("session_id")
+        if not isinstance(client_session, str) or not client_session:
+            raise PyEzvizError("Missing EZVIZ client session for stream invite")
+        request_xml = _build_invite_realtime_stream_xml(
+            session_flag=session_flag,
+            operation_code=device_session.operation_code,
+            channel=channel,
+            listener_ip=listener_ip,
+            listener_port=listener_port,
+            stream_type=stream_type,
+            transport_protocol=transport_protocol,
+            encrypt_stream=encrypt_stream,
+        )
+        transfer = self._send_device_transfer(
+            serial,
+            device_session=device_session,
+            inner_payload=request_xml,
+            inner_command=CAS_COMMAND_INVITE_REALTIME_STREAM,
+            inner_encrypted=True,
+        )
+        if transfer.outer_result != 0:
+            raise PyEzvizError(
+                "EZVIZ stream invite transfer was rejected "
+                f"({transfer.outer_result})"
+            )
+        parsed = _parse_invite_stream_frame(transfer.inner)
+        if parsed.result != 0:
+            raise PyEzvizError(
+                f"EZVIZ direct-reverse stream invite was rejected ({parsed.result})"
+            )
+        return parsed
+
+    def _send_device_transfer(
+        self,
+        serial: str,
+        *,
+        device_session: CasDeviceSession,
+        inner_payload: bytes,
+        inner_command: int,
+        inner_encrypted: bool,
+        client_type: int = 0,
+        inner_sequence: int | None = None,
+        outer_sequence: int | None = None,
+    ) -> CasTransferResponse:
+        """Send one current-SDK nested transfer through the CAS control plane."""
+        session_id = self._token.get("session_id")
+        if not isinstance(session_id, str) or not session_id:
+            raise PyEzvizError("Missing EZVIZ client session for device transfer")
+        payload = _build_device_transfer_request(
+            session_id=session_id,
+            serial=serial,
+            device_session=device_session,
+            inner_payload=inner_payload,
+            inner_command=inner_command,
+            inner_encrypted=inner_encrypted,
+            inner_sequence=(
+                self.next_native_sequence()
+                if inner_sequence is None
+                else inner_sequence
+            ),
+            outer_sequence=(
+                self.next_native_sequence()
+                if outer_sequence is None
+                else outer_sequence
+            ),
+            client_type=client_type,
+        )
+        host, port = self._cloud_address()
+        sock = socket.create_connection((host, port))
+        if hasattr(sock, "settimeout"):
+            sock.settimeout(CAS_SOCKET_TIMEOUT)
+        sock = _wrap_cas_tls_socket(
+            sock,
+            host=host,
+            certificate_sha256=self._cas_certificate_sha256,
+        )
+        if hasattr(sock, "settimeout"):
+            sock.settimeout(CAS_SOCKET_TIMEOUT)
+        try:
+            _send_all(sock, payload)
+            response = _recv_native_frame(sock)
+        except TimeoutError as err:
+            raise PyEzvizError(
+                "Timed out waiting for direct-reverse CAS response"
+            ) from err
+        except ConnectionResetError as err:
+            raise PyEzvizError("Direct-reverse CAS connection was reset") from err
+        except (socket.gaierror, ConnectionRefusedError) as err:
+            raise InvalidHost("Invalid EZVIZ CAS IP or hostname") from err
+        finally:
+            sock.close()
+
+        return _parse_transfer_response(response, key=device_session.key)
+
