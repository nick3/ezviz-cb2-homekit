+def _native_aes_key(key: str | bytes) -> bytes:
+    """Return the exact AES-128 key accepted by the native stream library."""
+    raw_key = key.encode("latin1") if isinstance(key, str) else key
+    if len(raw_key) != 16:
+        raise PyEzvizError("EZVIZ CAS AES key must be exactly 16 bytes")
+    return raw_key
+
+
+def _pkcs7_pad(payload: bytes, block_size: int = AES.block_size) -> bytes:
+    padding_size = block_size - (len(payload) % block_size)
+    return payload + bytes([padding_size]) * padding_size
+
+
+def _pkcs7_unpad(payload: bytes, block_size: int = AES.block_size) -> bytes:
+    if not payload or len(payload) % block_size:
+        raise PyEzvizError("Invalid EZVIZ CAS encrypted payload length")
+    padding_size = payload[-1]
+    if padding_size < 1 or padding_size > block_size:
+        raise PyEzvizError("Invalid EZVIZ CAS AES padding")
+    if payload[-padding_size:] != bytes([padding_size]) * padding_size:
+        raise PyEzvizError("Invalid EZVIZ CAS AES padding")
+    return payload[:-padding_size]
+
+
+def _build_native_encrypted_frame(
+    payload: bytes,
+    *,
+    key: str | bytes,
+    command: int,
+    sequence: int,
+    embedded_message_length: int = 0,
+) -> bytes:
+    """Reproduce ``ssl_generate_packet``/``GetMsgHeadReq`` byte-for-byte.
+
+    The native wrapper encrypts with AES-128-CBC and a fixed 16-byte IV,
+    records the encrypted body length twice (minus the embedded message length
+    in the last field), and appends the lowercase ASCII MD5 of the ciphertext.
+    """
+    if embedded_message_length < 0:
+        raise ValueError("embedded_message_length must not be negative")
+    cipher = AES.new(
+        _native_aes_key(key),
+        AES.MODE_CBC,
+        CAS_NATIVE_AES_IV,
+    )
+    ciphertext = cipher.encrypt(_pkcs7_pad(payload))
+    xml_size_hint = len(ciphertext) - embedded_message_length
+    if xml_size_hint < 0:
+        raise ValueError("embedded message is larger than encrypted payload")
+    return (
+        _cas_frame_header(
+            sequence=sequence,
+            command=command,
+            flags=CAS_ENCRYPTED_FRAME_FLAG,
+            body_size_hint=len(ciphertext),
+            tail_size_hint=xml_size_hint,
+        )
+        + ciphertext
+        + hashlib.md5(ciphertext).hexdigest().encode("ascii")  # noqa: S324
+    )
+
+
+def _build_native_plain_frame(
+    payload: bytes,
+    *,
+    command: int,
+    sequence: int,
+    embedded_message_length: int = 0,
+) -> bytes:
+    """Build the unencrypted native frame used by the device callback check."""
+    if embedded_message_length < 0:
+        raise ValueError("embedded_message_length must not be negative")
+    xml_size_hint = len(payload) - embedded_message_length
+    if xml_size_hint < 0:
+        raise ValueError("embedded message is larger than plain payload")
+    return (
+        _cas_frame_header(
+            sequence=sequence,
+            command=command,
+            flags=0,
+            body_size_hint=len(payload),
+            tail_size_hint=xml_size_hint,
+        )
+        + payload
+        + hashlib.md5(payload).hexdigest().encode("ascii")  # noqa: S324
+    )
+
+
+def _parse_native_frame(payload: bytes, *, key: str | bytes) -> CasNativeFrame:
+    """Parse one native encrypted CAS frame, including its 32-byte digest."""
+    header = CasFrameHeader.parse(payload)
+    frame_size = CAS_FRAME_HEADER_SIZE + header.body_size_hint + CAS_RESPONSE_DIGEST_SIZE
+    if len(payload) < frame_size:
+        raise PyEzvizError(
+            f"EZVIZ CAS frame is truncated ({len(payload)} < {frame_size})"
+        )
+    body_start = CAS_FRAME_HEADER_SIZE
+    body_end = body_start + header.body_size_hint
+    body = payload[body_start:body_end]
+    digest = payload[body_end:frame_size]
+    expected_digest = hashlib.md5(body).hexdigest().encode("ascii")  # noqa: S324
+    digest_valid = hmac.compare_digest(digest.lower(), expected_digest)
+
+    if header.flags == CAS_ENCRYPTED_FRAME_FLAG:
+        cipher = AES.new(
+            _native_aes_key(key),
+            AES.MODE_CBC,
+            CAS_NATIVE_AES_IV,
+        )
+        plaintext = _pkcs7_unpad(cipher.decrypt(body))
+    elif header.flags == 0:
+        plaintext = body
+    else:
+        raise PyEzvizError(
+            f"Unsupported EZVIZ CAS frame encryption flag: {header.flags:#x}"
+        )
+    return CasNativeFrame(
+        header=header,
+        plaintext=plaintext,
+        digest_valid=digest_valid,
+    )
+
