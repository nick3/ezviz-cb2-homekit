+def _cas_tls_context(*, pinned_certificate: bool = False) -> ssl.SSLContext:
+    """Return the legacy TLS context accepted by the CAS cloud endpoint.
+
+    Device-specific CAS hosts can present a CA-valid certificate whose names do
