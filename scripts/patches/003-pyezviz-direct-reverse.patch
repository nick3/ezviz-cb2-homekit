+def _wrap_cas_tls_socket(
+    sock: Any,
+    *,
+    host: str,
+    certificate_sha256: str | None,
+) -> Any:
+    """Wrap a CAS socket and optionally enforce an exact expired-cert pin."""
+    wrapped = _cas_tls_context(
+        pinned_certificate=certificate_sha256 is not None
+    ).wrap_socket(sock, server_hostname=host)
+    if certificate_sha256 is None:
+        return wrapped
+    peer_certificate = wrapped.getpeercert(binary_form=True)
+    if not isinstance(peer_certificate, bytes):
+        wrapped.close()
+        raise PyEzvizError("CAS server did not provide a certificate for pinning")
+    actual = hashlib.sha256(peer_certificate).hexdigest()
+    if not hmac.compare_digest(actual, certificate_sha256):
+        wrapped.close()
+        raise PyEzvizError("CAS server certificate fingerprint does not match the pin")
+    return wrapped
+
