+def _recv_exact(sock: Any, size: int) -> bytes:
+    """Read exactly ``size`` bytes or raise on a closed CAS connection."""
+    chunks: list[bytes] = []
+    received = 0
+    while received < size:
+        chunk = sock.recv(size - received)
+        if not chunk:
+            raise PyEzvizError("EZVIZ CAS connection closed during frame receive")
+        chunks.append(chunk)
+        received += len(chunk)
+    return b"".join(chunks)
+
+
+def _recv_native_frame(sock: Any) -> bytes:
+    header_bytes = _recv_exact(sock, CAS_FRAME_HEADER_SIZE)
+    header = CasFrameHeader.parse(header_bytes)
+    return header_bytes + _recv_exact(
+        sock,
+        header.body_size_hint + CAS_RESPONSE_DIGEST_SIZE,
+    )
